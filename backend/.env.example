# Optional. If unset (or the call fails/times out), opsAgent.ts transparently
# falls back to deterministic regex/keyword parsing — the app never depends
# on this key to run any of the 3 headline demos (RESOLVE / PROTECT / ESCALATE).
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-3-5-haiku-latest if unset.
ANTHROPIC_MODEL=

# Set by most hosts (Render, Railway) automatically. Defaults to 5000.
PORT=5000
